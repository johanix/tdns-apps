===== FILE /etc/tdns/auth-pq-zones.yaml
# Generated by tdns-zonegen -- do not edit by hand.
# Merge these blocks into the tdns-auth config; do NOT pull this in with
# include:, whose merge would replace the server's own zones: list.
#
# dnssec guardrail keys are spelled "large_algorithms" / "split_algorithms" here.
# tdns#406 respells these with hyphens and keeps no alias; if the server
# ignores them, that rename has landed and zonegen needs updating.

dnssec:
   large_algorithms:  [ FALCON512, MLDSA44, MLDSA87, SLHDSA128S ]
   split_algorithms:
      MLDSA44:  [ ED25519 ]
      MLDSA87:  [ ED25519 ]
      RSASHA256:  [ ED25519 ]
      SLHDSA128S:  [ ED25519 ]
   policies:
      ed25519-ed25519:
         algorithm:  ED25519
         mode:       ksk-zsk
         ksk:
            algorithm:  ED25519
            lifetime:   forever
         zsk:
            algorithm:  ED25519
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d
      falcon512-falcon512:
         algorithm:  FALCON512
         mode:       ksk-zsk
         ksk:
            algorithm:  FALCON512
            lifetime:   forever
         zsk:
            algorithm:  FALCON512
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d
      mldsa44-ed25519:
         algorithm:  ED25519
         mode:       ksk-zsk
         ksk:
            algorithm:  MLDSA44
            lifetime:   forever
         zsk:
            algorithm:  ED25519
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d
      mldsa87-ed25519:
         algorithm:  ED25519
         mode:       ksk-zsk
         ksk:
            algorithm:  MLDSA87
            lifetime:   forever
         zsk:
            algorithm:  ED25519
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d
      rsasha256-ed25519:
         algorithm:  ED25519
         mode:       ksk-zsk
         ksk:
            algorithm:  RSASHA256
            lifetime:   forever
         zsk:
            algorithm:  ED25519
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d
      slhdsa128s-ed25519:
         algorithm:  ED25519
         mode:       ksk-zsk
         ksk:
            algorithm:  SLHDSA128S
            lifetime:   forever
         zsk:
            algorithm:  ED25519
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d
      sqisign1-sqisign1:
         algorithm:  SQISIGN1
         mode:       ksk-zsk
         ksk:
            algorithm:  SQISIGN1
            lifetime:   forever
         zsk:
            algorithm:  SQISIGN1
            lifetime:   forever
         csk:
            lifetime:  none
         sigvalidity:
            default:  14d
            dnskey:   30d
            ds:       14d

zones:
   - name:          pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  ed25519-ed25519
   - name:          mldsa87-ed25519.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/mldsa87-ed25519.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  mldsa87-ed25519
   - name:          mldsa44-ed25519.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/mldsa44-ed25519.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  mldsa44-ed25519
   - name:          slhdsa128s-ed25519.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/slhdsa128s-ed25519.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  slhdsa128s-ed25519
   - name:          falcon512-falcon512.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/falcon512-falcon512.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  falcon512-falcon512
   - name:          sqisign1-sqisign1.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/sqisign1-sqisign1.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  sqisign1-sqisign1
   - name:          ed25519-ed25519.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/ed25519-ed25519.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  ed25519-ed25519
   - name:          rsasha256-ed25519.pq.example.
     type:          primary
     zonefile:      /etc/tdns/zones/rsasha256-ed25519.pq.example.
     store:         map
     options:       [ online-signing ]
     dnssecpolicy:  rsasha256-ed25519
